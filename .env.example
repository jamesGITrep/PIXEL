# ==============================================================================
# PixelMosaic Environment Configuration
# ==============================================================================

# Storage Backend Mode: 'local' (zero-cost sandbox) or 'gcs' (Google Cloud Storage)
STORAGE_BACKEND=local

# Google Cloud Platform Configuration (Required only when STORAGE_BACKEND=gcs)
GCP_PROJECT_ID=my-pixelmosaic-project
GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account-key.json

# Cloud Storage Bucket Aliases
GCS_BUCKET_PHOTOS=pixelmosaic-photo-library
GCS_BUCKET_TARGETS=pixelmosaic-target-posters
GCS_BUCKET_THUMBNAILS=pixelmosaic-thumbnails
GCS_BUCKET_OUTPUT=pixelmosaic-output-mosaics
GCS_BUCKET_TASKS=pixelmosaic-tasks
GCS_BUCKET_MAPPINGS=pixelmosaic-mappings

# Cluster Auto-Scaling & Compute Defaults
PORT=8080
DEFAULT_GRID_COLS=60
DEFAULT_GRID_ROWS=60
DEFAULT_CHUNK_ROWS=15
DEFAULT_PROXIMITY_RADIUS=5
DEFAULT_TINT_PERCENT=20
